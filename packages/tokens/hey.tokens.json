  "space": {
    "$description": "The only spacing steps. Containers own gaps; components have no outer margin.",
    "4": { "$value": 4 },
    "8": { "$value": 8 },
    "16": { "$value": 16 },
    "24": { "$value": 24 },
    "32": { "$value": 32 }
  },
  "radius": {
    "sm": { "$value": 8 },
    "md": { "$value": 12 },
    "lg": { "$value": 16 },
    "xl": { "$value": 24 },
    "full": { "$value": 999 }
  },
  "border-width": {
    "hairline": { "$value": 1 },
    "strong": { "$value": 2 },
    "focus": { "$value": 3 }
  },
  "font": {
    "family": { "$value": "Pretendard" },
    "family-fallback": { "$value": "\"Hiragino Sans\", \"Noto Sans JP\", \"PingFang SC\", \"Noto Sans SC\", system-ui, sans-serif" }
  },
  "type": {
    "$description": "size/lineHeight in px (web) or dp/sp (car). weight is numeric. tracking in em.",
    "web": {
      "display": { "size": 32, "lineHeight": 40, "weight": 700, "tracking": -0.02 },
      "title": { "size": 24, "lineHeight": 32, "weight": 700, "tracking": -0.02 },
      "heading": { "size": 20, "lineHeight": 28, "weight": 650, "tracking": -0.01 },
      "body": { "size": 16, "lineHeight": 24, "weight": 400, "tracking": 0 },
      "body-strong": { "size": 16, "lineHeight": 24, "weight": 600, "tracking": 0 },
      "label": { "size": 14, "lineHeight": 20, "weight": 600, "tracking": 0 },
      "caption": { "size": 13, "lineHeight": 20, "weight": 500, "tracking": 0 }
    },
    "car": {
      "hero": { "size": 72, "lineHeight": 88, "weight": 700, "tracking": -0.02 },
      "title": { "size": 44, "lineHeight": 56, "weight": 700, "tracking": -0.01 },
      "heading": { "size": 36, "lineHeight": 48, "weight": 650, "tracking": 0 },
      "body": { "size": 32, "lineHeight": 44, "weight": 500, "tracking": 0 },
      "label": { "size": 28, "lineHeight": 36, "weight": 650, "tracking": 0 },
      "caption": { "size": 24, "lineHeight": 32, "weight": 500, "tracking": 0 }
    }
  },
  "size": {
    "touch-web": { "$value": 44, "$description": "minimum press target on the passenger web" },
    "touch-car": { "$value": 76, "$description": "minimum press target on the car display (AAOS guidance)" },
    "touch-car-primary": { "$value": 96 },
    "icon-web": { "$value": 24 },
    "icon-car": { "$value": 40 },
    "content-max-web": { "$value": 480, "$description": "passenger web column width cap" }
  },
  "sheet": {
    "$description": "Bottom sheet geometry (product-foundations 2.3). Not spacing; the sheet component owns these.",
    "radius": { "$value": 24 },
    "handle-width": { "$value": 32 },
    "handle-height": { "$value": 4 },
    "top-offset": { "$value": 64 },
    "max-width": { "$value": 640 }
  },
  "motion": {
    "fast": { "$value": 120 },
    "base": { "$value": 200 },
    "slow": { "$value": 320 },
    "easing-standard": { "$value": [0.2, 0, 0, 1] },
    "easing-exit": { "$value": [0.3, 0, 1, 1] }
  },
  "elevation": {
    "raised": { "$value": "0 1px 2px rgba(25,37,31,0.08), 0 2px 8px rgba(25,37,31,0.06)" },
    "overlay": { "$value": "0 8px 32px rgba(25,37,31,0.18)" }
  }
